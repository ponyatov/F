{
    "version": 6,
    "buildPresets": [
        {
            "name":              "linux",
            "configurePreset":   "linux",
            "targets":          ["all","install"]
        },
        {
            "name":              "pillF103",
            "configurePreset":   "pillF103",
            "targets":          ["all","install"]
        }
    ],
    "configurePresets": [
        {
            "name": "common",
            "hidden": true,
            "binaryDir": "${sourceDir}/tmp/${presetName}",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_VERBOSE_MAKEFILE": true,
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux",
            "inherits": "common",
            "displayName": "x86_64-linux-gnu",
            "description": "native host",
            "toolchainFile": "${sourceDir}/cmake/x86_64-linux-gnu.cmake",
            "cacheVariables": {
                "HW":"pc", "CPU":"i5", "ARCH":"x86_64", "OS":"linux"
            }
        },
        {
            "name": "cortexM",
            "hidden": true,
            "inherits": "common",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {"OS":"bare"}
        },
        {
            "name": "cortexM3",
            "hidden": true,
            "inherits": "cortexM",
            "cacheVariables": {"ARCH":"cortexM3"}
        },
        {
            "name": "pillF103",
            "inherits": "cortexM3",
            "cacheVariables": {
                "HW" :"pillF103",
                "CPU":"stm32f103c8t", "SERIES": "STM32F1"
            }
        }
    ]
}
