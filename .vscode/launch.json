{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "rust",
            "cargo": {
                "args": [
                    "build",
                    "--bin=${workspaceFolderBasename}",
                    "--package=${workspaceFolderBasename}"
                ],
                "filter": {
                    "name": "${workspaceFolderBasename}",
                    "kind": "bin"
                }
            },
            "args": ["1024", "578"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name"               : "rs:lm3s6",
            "type"               : "cortex-debug",
            "request"            : "launch",
            "executable"         : "target/thumbv7m-none-eabi/debug/fortex",
            "cwd"                : "${workspaceFolder}",
            "servertype"         : "qemu",
            "cpu"                : "cortex-m3",
            "machine"            : "lm3s6965evb",
            // "gdbTarget": ":12345",
            "preLaunchTask"      : "cargo: lm3s6",
            "runToEntryPoint"    : "main",
            "preRestartCommands" : [
                "load",
                "break Reset",
                "break ResetHandler",
                "break DefaultHandler",
                "break DefaultPreInit",
            ]
        },
        {
            "name"               : "rs:l496disco",
            "type"               : "cppdbg",
            "request"            : "launch",
            "program"            : "target/thumbv7em-none-eabi/debug/fortex",
            "cwd"                : "${workspaceFolder}",
            "preLaunchTask"      : "cargo: l496disco",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerArgs": "--silent",
            "miDebuggerServerAddress": "localhost:12345",
            "useExtendedRemote": true,
            "setupCommands": [
                {"text": "-enable-pretty-printPruning", "ignoreFailures": true}
            ],
            "stopAtEntry": true, // don't disable!
            "postRemoteConnectCommands": [
                {"text": "monitor reset halt"},
                {"text": "set print asm-demangle on"},
                {"text": "monitor arm semihosting enable"},
                {"text": "break main"},
                {"text": "break DefaultHandler"},
                {"text": "break HardFault"},
                {"text": "break rust_begin_unwind"},
                {"text": "load"},
                {"text": "monitor reset halt"}, // req
            ]
        },
        {
            "name": "cortexM",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            // "preLaunchTask": "debug: openocd",
            // "preLaunchTask": "CMake: build",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerArgs": "--silent",
            "miDebuggerServerAddress": "localhost:12345",
            "useExtendedRemote": true,
            "setupCommands": [
                {"text": "-enable-pretty-printing", "ignoreFailures": true}
            ],
            // "debugServerPath": "openocd",
            // "debugServerArgs": "-f ${workspaceFolder}/hw/${command:cmake.activeConfigurePresetName}/${command:cmake.activeConfigurePresetName}.openocd -c \"program ${command:cmake.launchTargetPath} verify reset\"",
            // "serverStarted": "connections",
            "stopAtEntry": false, // don't enable!
            "postRemoteConnectCommands": [
                {"text": "monitor reset halt"},
                {"text": "load"},
                {"text": "set substitute-path /home/pere/src/newlib-salsa ${userHome}/em/ref/newlib-salsa"},
                {"text": "b Reset_Handler"},
                {"text": "b DefaultHandler"},
                // {"text": "b SystemInit"},
                // {"text": "b __libc_init_array"},
                {"text": "b main"},
                // {"text": "b MX_GPIO_Init"},
                // {"text": "b sbrk"}, {"text": "b _sbrk"},
                // {"text": "b jsvObjectSetChild"},
                {"text": "monitor reset halt"}, // req
            ],
        },
        {
            "name": "linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "preLaunchTask": "CMake: build",
            "args": ["${workspaceFolder}/lib/${workspaceFolderBasename}.ini"],
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "stopAtEntry": true,
            "MIMode": "gdb",
            "setupCommands": [
                {"text": "-enable-pretty-printing", "ignoreFailures": true}
            ]
        }
    ]
}
