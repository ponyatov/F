{
    "version": 4,
    "configurations": [
        {
            "name": "x86_64-linux-gnu",
            "includePath": [
                "${workspaceFolder}/inc/**",
                "${workspaceFolder}/tmp/**",
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/os/linux/inc/**",
                "${workspaceFolder}/lib/core/inc/**",
                "${workspaceFolder}/lib/cli/inc/**"
            ],
            "forcedInclude": [],
            "compilerArgs": ["-march=native"],
            "defines": [
                "PC", "I5", "X86_64", "LINUX"
            ],
            "cStandard": "gnu17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "gcc-x64",
            "compilerPath": "/usr/bin/x86_64-linux-gnu-g++"
        }
    ]
}
