{
    "version": "2.0.0",
    "tasks": [
        {
            "label"          : "project: install",
            "type"           : "shell",
            "command"        : "make install",
            "problemMatcher" : []
        },
        {
            "label"          : "project: update",
            "type"           : "shell",
            "command"        : "make update",
            "problemMatcher" : []
        },
        {
            "label"          : "git: whoami",
            "type"           : "shell",
            "command"        : "make `whoami`",
            "problemMatcher" : []
        },
        {
            "label"          : "git: dev",
            "type"           : "shell",
            "command"        : "make dev",
            "problemMatcher" : []
        },
        {
            "label"          : "debug: openocd",
            "type"           : "shell",
            "group"          : {"kind": "build"},
            "dependsOn"      : "CMake: build",
            "command"        : "openocd -f ${workspaceFolder}/hw/${command:cmake.activeConfigurePresetName}/${command:cmake.activeConfigurePresetName}.ocd -c \"program ${command:cmake.launchTargetPath} verify reset\"",
            "problemMatcher" : []
        },
        {
            "type"           : "cmake",
            "label"          : "cmake: build",
            "command"        : "build",
            "targets"        : ["all"],
            "preset"         : "${command:cmake.activeBuildPresetName}",
            "group"          : "build",
            "problemMatcher" : [],
            "promptOnClose"  : false
        },
        {
            "label"          :  "qemu: lm3s6",
            "type"           :  "shell",
            "command"        :  "qemu-system-arm",
            "args"           : ["-machine","lm3s6965evb","-cpu","cortex-m3",
                                "-nographic", "-semihosting",
                                "-kernel","target/thumbv7m-none-eabi/debug/fortex"],
            "options"        : {"cwd": "${workspaceFolder}"},
            "problemMatcher" : []
        },
        {
            "label"          :  "cargo: lm3s6",
            "type"           :  "shell",
            "command"        :  "cargo",
            "args"           : ["build", "--target", "thumbv7m-none-eabi"],
            "options"        : {"cwd": "${workspaceFolder}", "env": {"HW":"lm3s6"}},
            "problemMatcher" : ["$rustc"],
            "presentation"   : {"showReuseMessage": false, "focus": true, "reveal": "silent", "close": false},
            "group"          : {"kind": "build", "isDefault": true}
        },
        {
            "label"          :  "cargo: l496disco",
            "type"           :  "shell",
            "command"        :  "cargo",
            "args"           : ["build", "--target", "thumbv7em-none-eabi"],
            "options"        : {"cwd": "${workspaceFolder}", "env": {"HW":"l496disco"}},
            "problemMatcher" : ["$rustc"],
            "presentation"   : {"showReuseMessage": false, "focus": true, "reveal": "silent", "close": true},
            "group"          : {"kind": "build", "isDefault": true}
        },
        {
            "label"          : "openocd: l496disco",
            "type"           : "shell",
            "command"        : "openocd",
            "args"           : ["-f", "hw/l496disco/l496disco.ocd",
                                "-c", "program target/thumbv7em-none-eabi/debug/fortex verify"],
            "problemMatcher" : [],
            "options"        : {"cwd": "${workspaceFolder}"},
            "presentation"   : {"showReuseMessage": false, "focus": false, "close": true}
        },
    ]
}
