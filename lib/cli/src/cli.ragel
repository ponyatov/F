#include "os.hpp"
#include "cli.hpp"

%%machine cli;
%%write  data;

static int   cs  = 0;           ///< current state
static int   act = 0;           ///< ???
static char* eof = nullptr;     ///< end of file marker
static char* ts  = nullptr;     ///< token start
static char* te  = nullptr;     ///< token end

void cli(char* p, char* pe) {
    eof = pe; cs = act = 0; ts = te = nullptr;
    %%write init;
    %%write exec;
}

%%{
    comment = '#' [^\n]*;                   # comment
    nl      = '\n';                         # new line
    sp      = [ \r\t]+;                     # drop spaces
    sign    = [+\-];                        # sign

    dec     = sign ? digit+;                # decimal int
    hex     = "0x" [0-9a-fA-F]+;            # hexadecimal
    oct     = "0o" [0-7]+;                  # octal
    bin     = "0b" [01]+;                   # binary
    num     = sign ? digit+ '.' digit+;     # floating point

    id      = [_a-zA-Z][_a-zA-Z0-9]*;       # variable/name

    cli := |*
        comment => { };
        nl+     => { yylineno += te-ts; dump(); };
        sp      => { };

        num     => { push(Cell{t:T::NUM,v:{f:num(ts,te)}}); };
        hex     => { push(Cell{t:T::HEX,v:{n:hex(ts,te)}}); };
        oct     => { push(Cell{t:T::OCT,v:{n:oct(ts,te)}}); };
        bin     => { push(Cell{t:T::BIN,v:{n:bin(ts,te)}}); };
        dec     => { push(Cell{t:T::INT,v:{n:dec(ts,te)}}); };

        "nop"   => { push(Cell{t : T::CMD, v : {op : Op::nop }}); };
        "halt"  => { push(Cell{t : T::CMD, v : {op : Op::halt}}); };

        "add"   => { push(Cell{t : T::CMD, v : {op : Op::add}}); };
        "sub"   => { push(Cell{t : T::CMD, v : {op : Op::sub}}); };

        id      => { push(Cell{t:T::ID ,v:{s:strndupa(ts,te-ts)}}); };
        any     => { push(Cell{t:T::CHAR,v:{c:ts[0]}}); };
   *|;
}%%
