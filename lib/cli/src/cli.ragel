#include "os.hpp"
#include "cli.hpp"

%%machine cli;
%%write  data;

static int   cs  = 0;           ///< current state
static int   act = 0;           ///< ???
static char* eof = nullptr;     ///< end of file marker
static char* ts  = nullptr;     ///< token start
static char* te  = nullptr;     ///< token end

void cli(char* p, char* pe) {
    eof = pe; cs = act = 0; ts = te = nullptr;
    %%write init;
    %%write exec;
}

%%{
    comment = '#' [^\n]*;                   # comment
    nl      = '\n';                         # new line
    sp      = [ \r\t]+;                     # drop spaces
    sign    = [+\-];                        # sign

    dec     = sign ? digit+;                # decimal int
    hex     = "0x" [0-9a-fA-F]+;            # hexadecimal
    oct     = "0o" [0-7]+;                  # octal
    bin     = "0b" [01]+;                   # binary
    num     = sign ? digit+ '.' digit+;     # floating point

    cmd     = "nop"|"halt"|".";             # VM command
    id      = [_a-zA-Z][_a-zA-Z0-9]*;       # variable/name

    cli := |*
        comment => { };
        nl+     => { yylineno += te-ts; dump(); };
        sp      => { };

        hex     => { push(hex(ts,te)); };
        oct     => { push(oct(ts,te)); };
        bin     => { push(bin(ts,te)); };
        dec     => { push(dec(ts,te)); };
        num     => { push(num(ts,te)); };

        any     => { push(ts[0]); };
        cmd     => { push(strndupa(ts,te-ts)); };
        id      => { push(strndupa(ts,te-ts)); };
   *|;
}%%
